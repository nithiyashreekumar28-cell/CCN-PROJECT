#include <stdio.h>
#include <conio.h>
#include <string.h>

void main()
{
    char text[100], encrypted[100], decrypted[100];
    int i, key;

    clrscr();

    printf("ENCRYPTION AND DECRYPTION\n");
    printf("------------------------\n");

    printf("Enter the message: ");
    gets(text);

    printf("Enter the key (1-25): ");
    scanf("%d", &key);

    /* Encryption */
    for(i = 0; text[i] != '\0'; i++)
    {
        if(text[i] >= 'A' && text[i] <= 'Z')
            encrypted[i] = 'A' +
            (text[i] - 'A' + key) % 26;

        else if(text[i] >= 'a' && text[i] <= 'z')
            encrypted[i] = 'a' +
            (text[i] - 'a' + key) % 26;

        else
            encrypted[i] = text[i];
    }
    encrypted[i] = '\0';

    printf("\nOriginal Message : %s", text);
    printf("\nEncrypted Message: %s", encrypted);

    /* Decryption */
    for(i = 0; encrypted[i] != '\0'; i++)
    {
        if(encrypted[i] >= 'A' &&
           encrypted[i] <= 'Z')
            decrypted[i] = 'A' +
            (encrypted[i] - 'A' - key + 26) % 26;

        else if(encrypted[i] >= 'a' &&
                encrypted[i] <= 'z')
            decrypted[i] = 'a' +
            (encrypted[i] - 'a' - key + 26) % 26;

        else
            decrypted[i] = encrypted[i];
    }
    decrypted[i] = '\0';

    printf("\nDecrypted Message: %s", decrypted);

    getch();
}
